---
import Layout from '../layouts/Layout.astro';
import HeroSlider from '../components/HeroSlider.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import DigitalPulse from '../components/DigitalPulse.astro';
import InteractiveVision from '../components/InteractiveVision.astro';
import ConversionGateway from '../components/ConversionGateway.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
	<main class="relative z-10 w-full min-h-screen bg-[#0A0A0A]">
		<HeroSlider />
        <ServicesGrid />
        <InteractiveVision />
        <DigitalPulse />
        <ConversionGateway />
	</main>
    <Footer />
</Layout>

