---
const metrics = [
    { label: "PAGES DELIVERED", target: 517, suffix: "+", desc: "Your vision. Brought to life.", color: "text-[#00F5FF]", glowClass: "drop-shadow-[0_0_10px_rgba(0,245,255,0.5)]" },
    { label: "SATISFACTION RATE", target: 100, suffix: "%", desc: "We don't stop until it's perfect.", color: "text-white", glowClass: "drop-shadow-[0_0_10px_rgba(255,255,255,0.3)]" },
    { label: "ALWAYS ON", target: 24, suffix: "/7", desc: "Every question answered. Every time.", color: "text-[#8b5cf6]", glowClass: "drop-shadow-[0_0_10px_rgba(139,92,246,0.5)]" }
];
---

<section id="pulse" class="relative min-h-screen flex flex-col justify-center py-20 md:py-28 px-6 md:px-20 overflow-hidden bg-[#0A0A0A]">
    
    <!-- MESH GRADIENT LAYER (Liquid Background) -->
    <div class="absolute inset-0 z-0 pointer-events-none">
        <!-- Animated Blobs -->
        <div class="blob absolute top-[-10%] left-[15%] w-[40vw] h-[40vw] bg-[#00F5FF]/5 rounded-full blur-[120px] animate-liquid-1"></div>
        <div class="blob absolute bottom-[-10%] right-[15%] w-[40vw] h-[40vw] bg-[#7C3AED]/5 rounded-full blur-[120px] animate-liquid-2"></div>
        <div class="blob absolute top-[30%] left-[40%] w-[30vw] h-[30vw] bg-[#7C3AED]/3 rounded-full blur-[120px] animate-liquid-3"></div>
    </div>

    <!-- FROSTED GLASS OVERLAY -->
    <div class="absolute inset-0 z-[1] backdrop-blur-[120px] bg-white/[0.01]"></div>

    <!-- CONTENT LAYER -->
    <div class="max-w-7xl mx-auto w-full relative z-10 flex flex-col h-full justify-center">
        <!-- Section Header -->
        <div class="mb-16 md:mb-24 text-center">
            <h2 class="text-3xl md:text-5xl lg:text-6xl font-black text-white tracking-tighter mb-4 gsap-reveal-text">
                <span data-i18n="pulse.section_title_1">Built on trust.</span> <span class="text-[#00F5FF]" data-i18n="pulse.section_title_2">Proven by results.</span>
            </h2>
            <p class="text-zinc-400 max-w-2xl mx-auto text-[0.9rem] md:text-base lg:text-lg font-light leading-relaxed gsap-reveal-text" data-i18n="pulse.section_desc">
                Every number here has a story behind it.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 items-start justify-center gap-y-12 md:gap-y-0 gsap-reveal-container">
            {metrics.map((metric, index) => (
                <div class={`flex flex-col justify-start items-center w-full h-full py-8 md:py-12 gsap-reveal-card ${index > 0 ? 'md:border-l md:border-white/5' : ''}`}>
                    <div class="group cursor-default flex flex-col items-center transition-transform duration-300 hover:-translate-y-1">
                        <span class="text-zinc-500 text-[10px] tracking-[0.2em] uppercase font-bold mb-4 block" data-i18n={`pulse.metric_${index + 1}_label`}>
                            {metric.label}
                        </span>
                        <h3 class={`text-7xl md:text-[5vw] lg:text-[7vw] font-black leading-[0.9] tracking-tighter mt-6 ${metric.color} ${metric.glowClass} transition-all duration-300 hover:scale-105 select-none mb-3`}>
                            <span class="stat-count" data-target={metric.target}>0</span>{metric.suffix}
                        </h3>
                        <p class="text-zinc-400 text-sm max-w-[300px] mx-auto leading-relaxed text-center" data-i18n={`pulse.metric_${index + 1}_desc`}>
                            {metric.desc}
                        </p>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    // GSAP Context to avoid memory leaks
    let ctx = gsap.context(() => {
        const counts = document.querySelectorAll('.stat-count');
        const isHoverDevice = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
        
        counts.forEach(count => {
            const targetVal = parseInt(count.getAttribute('data-target') || '0', 10);
            
            if (isHoverDevice) {
                const obj = { value: 0 };
                gsap.to(obj, {
                    value: targetVal,
                    duration: 2,
                    ease: "power3.out",
                    scrollTrigger: {
                        trigger: count,
                        start: "top 85%",
                        toggleActions: "play none none none"
                    },
                    onUpdate: () => {
                        count.textContent = Math.floor(obj.value).toString();
                    }
                });
            } else {
                // On mobile, set final values instantly for immediate response
                count.textContent = targetVal.toString();
            }
        });
    });

    window.addEventListener('beforeunload', () => {
        ctx.revert();
    });
</script>

<style>
    h2 {
        font-family: 'Outfit', sans-serif;
    }

    /* Keyframes for Liquid Motion */
    @keyframes liquid-1 {
        0%, 100% { transform: translate(0, 0) scale(1); }
        33% { transform: translate(10%, 15%) scale(1.1); }
        66% { transform: translate(-5%, 10%) scale(0.9); }
    }
    @keyframes liquid-2 {
        0%, 100% { transform: translate(0, 0) scale(1); }
        33% { transform: translate(-15%, -10%) scale(0.95); }
        66% { transform: translate(10%, -5%) scale(1.05); }
    }
    @keyframes liquid-3 {
        0%, 100% { transform: translate(0, 0) scale(1); }
        50% { transform: translate(20%, -20%) scale(1.2); }
    }

    .animate-liquid-1 { animation: liquid-1 25s ease-in-out infinite; }
    .animate-liquid-2 { animation: liquid-2 30s ease-in-out infinite; }
    .animate-liquid-3 { animation: liquid-3 35s ease-in-out infinite; }

    @keyframes fade-in {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    .animate-fade-in { animation: fade-in 1s ease-out 0.8s forwards; }
</style>
